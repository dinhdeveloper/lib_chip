<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/rounded_dialog">

    <TextView
        android:id="@+id/txtLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/ready_scan"
        android:layout_marginTop="45dp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:lineHeight="17sp"
        android:textSize="15sp"/>



    <RelativeLayout
        android:id="@+id/lnImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/txtLabel"
        android:orientation="vertical"
        android:layout_marginTop="30dp">

        <ImageView
            android:id="@+id/imgScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_nfc"
            android:visibility="visible" />


        <ImageView
            android:id="@+id/imgCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/round_success_nfc"
            android:layout_centerInParent="true"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/imgCheck1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/check_success_nfc"
            android:layout_centerInParent="true"
            android:visibility="gone"/>


    </RelativeLayout>


    <TextView
        android:id="@+id/txtNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnImage"
        android:layout_marginStart="60dp"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="60dp"
        android:layout_marginRight="60dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:lineHeight="17sp"
        android:text="@string/note_scan"
        android:textColor="@color/black"
        android:textSize="15sp" />


    <unit.chip.libchip.common.DotProgressBar
        android:id="@+id/progress"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:layout_below="@+id/txtNote"
        android:layout_centerInParent="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp"
        android:visibility="gone"
        app:activeDot="@drawable/active_dot"
        app:dotSize="10dp"
        app:inactiveDot="@drawable/inactive_dot"
        app:jumpingSpeed="600"
        app:numberOfDots="8"
        app:spacing="10dp"
        tools:visibility="visible" />


    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/progress"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="55dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_btn_transparent_skyblue"
        android:gravity="center"
        android:text="Hủy"
        android:textColor="@color/black"
        android:textSize="16sp"/>



</RelativeLayout>